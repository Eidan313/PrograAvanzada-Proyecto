@model ListaPaginada<CategoriaFilaViewModel>
@{
    ViewData["Title"] = "Categorías";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Categorías</h1>
        <p class="text-muted mb-0">Agrupan los productos del catálogo</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Nueva categoría</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Nombre</th>
                <th class="text-center">Productos</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Elementos.Count == 0)
            {
                <tr>
                    <td colspan="3" class="text-center text-muted py-4">No hay categorías para mostrar.</td>
                </tr>
            }
            else
            {
                @foreach (var categoria in Model.Elementos)
                {
                    <tr>
                        <td class="fw-semibold">@categoria.Nombre</td>
                        <td class="text-center">@categoria.CantidadProductos</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@categoria.Id" class="btn btn-sm btn-outline-secondary">Ver</a>
                            <a asp-action="Edit" asp-route-id="@categoria.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@categoria.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<partial name="_Paginacion" model="Model" />
