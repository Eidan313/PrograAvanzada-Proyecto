@model Categoria
@{
    ViewData["Title"] = "Nueva categoría";
}

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none">Categorías</a>
    <h1 class="h2 mt-2 mb-1">Nueva categoría</h1>
    <p class="text-muted mb-0">El nombre es requerido y no se puede repetir.</p>
</div>

<form asp-action="Create" method="post" class="col-lg-6">
    <partial name="_Form" model="Model" />
    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-primary">Guardar categoría</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
