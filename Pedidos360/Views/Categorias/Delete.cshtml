@model Categoria
@{
    ViewData["Title"] = "Eliminar categoría";
}

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none">Categorías</a>
    <h1 class="h2 mt-2 mb-1">Eliminar categoría</h1>
</div>

<div class="alert alert-danger" role="alert">
    ¿Deseas eliminar la categoría <strong>@Model.Nombre</strong>? Esta acción no se puede deshacer.
</div>

<div class="d-flex gap-2 mt-3">
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
        <button type="submit" class="btn btn-danger">Eliminar categoría</button>
    </form>
    <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
</div>
