@model Pedido
@{ ViewData["Title"] = $"Pedido #{Model.Id}"; }
<h1>Pedido #@Model.Id</h1>
<dl class="row">
    <dt class="col-sm-3">Cliente</dt><dd class="col-sm-9">@(Model.Cliente?.Nombre ?? "Sin cliente")</dd>
    <dt class="col-sm-3">Fecha</dt><dd class="col-sm-9">@Model.Fecha.ToString("dd/MM/yyyy HH:mm")</dd>
    <dt class="col-sm-3">Estado</dt><dd class="col-sm-9">@Model.Estado</dd>
</dl>
<h2 class="h4">Productos</h2>
<table class="table table-bordered">
    <thead><tr><th>Producto</th><th>Cantidad</th><th>Precio unitario</th><th>Descuento</th><th>Total de línea</th></tr></thead>
    <tbody>
    @foreach (var detalle in Model.Detalles)
    {
        <tr><td>@(detalle.Producto?.Nombre ?? "Producto no disponible")</td><td>@detalle.Cantidad</td>
        <td>₡@detalle.PrecioUnit.ToString("N2")</td><td>@detalle.Descuento (@detalle.TipoDescuento)</td>
        <td>₡@detalle.TotalLinea.ToString("N2")</td></tr>
    }
    </tbody>
</table>
<div class="text-end"><p>Subtotal: ₡@Model.Subtotal.ToString("N2")</p><p>Impuestos: ₡@Model.Impuestos.ToString("N2")</p><strong>Total: ₡@Model.Total.ToString("N2")</strong></div>
<a asp-action="Index" class="btn btn-secondary mt-3">Volver al listado</a>
