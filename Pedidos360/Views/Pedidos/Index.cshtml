@model IEnumerable<Pedido>
@{ ViewData["Title"] = "Consulta de pedidos"; }
<h1>Consulta de pedidos</h1>
<p class="text-muted">Listado de pedidos registrados y su estado actual.</p>
<table class="table table-striped table-hover align-middle">
    <thead><tr><th>Número</th><th>Cliente</th><th>Fecha</th><th>Estado</th><th>Total</th><th></th></tr></thead>
    <tbody>
    @foreach (var pedido in Model)
    {
        <tr>
            <td>@pedido.Id</td><td>@(pedido.Cliente?.Nombre ?? "Sin cliente")</td>
            <td>@pedido.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
            <td><span class="badge @(pedido.Estado == EstadoPedido.Confirmado ? "bg-success" : "bg-secondary")">@pedido.Estado</span></td>
            <td>₡@pedido.Total.ToString("N2")</td>
            <td><a asp-action="Details" asp-route-id="@pedido.Id" class="btn btn-outline-primary btn-sm">Ver detalle</a></td>
        </tr>
    }
    </tbody>
</table>
@if (!Model.Any()) { <div class="alert alert-info">Todavía no hay pedidos registrados.</div> }
