@model Cliente
@{
    ViewData["Title"] = "Nuevo cliente";
}

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none">Clientes</a>
    <h1 class="h2 mt-2 mb-1">Nuevo cliente</h1>
    <p class="text-muted mb-0">Completa los datos para registrar un cliente.</p>
</div>

<form asp-action="Create" method="post" class="col-lg-8">
    <partial name="_Form" model="Model" />
    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-primary">Guardar cliente</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
