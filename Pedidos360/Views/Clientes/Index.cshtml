@model ClienteIndexViewModel
@{
    ViewData["Title"] = "Clientes";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Clientes</h1>
        <p class="text-muted mb-0">Directorio de clientes registrados</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Nuevo cliente</a>
</div>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-sm-8 col-md-6 col-lg-5">
        <label asp-for="Busqueda" class="visually-hidden">Buscar clientes</label>
        <input asp-for="Busqueda" class="form-control" placeholder="Buscar por nombre o cédula" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Buscar</button>
        @if (!string.IsNullOrWhiteSpace(Model.Busqueda))
        {
            <a asp-action="Index" class="btn btn-link">Limpiar</a>
        }
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Cédula</th>
                <th>Correo</th>
                <th>Teléfono</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Clientes.Count == 0)
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">No hay clientes para mostrar.</td>
                </tr>
            }
            else
            {
                @foreach (var cliente in Model.Clientes)
                {
                    <tr>
                        <td class="fw-semibold">@cliente.Nombre</td>
                        <td>@cliente.Cedula</td>
                        <td>@cliente.Correo</td>
                        <td>@cliente.Telefono</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@cliente.Id" class="btn btn-sm btn-outline-secondary">Ver</a>
                            <a asp-action="Edit" asp-route-id="@cliente.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@cliente.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
    <span class="small text-muted">@Model.TotalClientes cliente(s) · Página @Model.Pagina de @Model.TotalPaginas</span>
    <nav aria-label="Paginación de clientes">
        <ul class="pagination pagination-sm mb-0">
            <li class="page-item @(Model.Pagina <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-busqueda="@Model.Busqueda" asp-route-pagina="@(Model.Pagina - 1)">Anterior</a>
            </li>
            <li class="page-item @(Model.Pagina >= Model.TotalPaginas ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-busqueda="@Model.Busqueda" asp-route-pagina="@(Model.Pagina + 1)">Siguiente</a>
            </li>
        </ul>
    </nav>
</div>
