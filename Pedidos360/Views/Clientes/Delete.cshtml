@model Cliente
@{
    ViewData["Title"] = "Eliminar cliente";
    var tienePedidos = (bool)ViewBag.TienePedidos;
}

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none">Clientes</a>
    <h1 class="h2 mt-2 mb-1">Eliminar cliente</h1>
</div>

@if (tienePedidos)
{
    <div class="alert alert-warning" role="alert">
        Este cliente tiene pedidos asociados y no se puede eliminar.
    </div>
}
else
{
    <div class="alert alert-danger" role="alert">
        ¿Deseas eliminar el registro de <strong>@Model.Nombre</strong>? Esta acción no se puede deshacer.
    </div>
}

<dl class="row col-lg-8">
    <dt class="col-sm-4">Cédula</dt>
    <dd class="col-sm-8">@Model.Cedula</dd>
    <dt class="col-sm-4">Correo</dt>
    <dd class="col-sm-8">@Model.Correo</dd>
</dl>

<div class="d-flex gap-2 mt-3">
    @if (!tienePedidos)
    {
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-danger">Eliminar cliente</button>
        </form>
    }
    <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
</div>
