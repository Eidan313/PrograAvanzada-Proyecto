@model Pedidos360.Models.Producto
@{ViewData["Title"]="Eliminar producto";}
<h1>Eliminar producto</h1><div class="alert alert-warning">¿Seguro que deseas eliminar <strong>@Model.Nombre</strong>? No se puede eliminar si tiene pedidos.</div>
<form asp-action="Delete" asp-route-id="@Model.Id" method="post"><button type="submit" class="btn btn-danger">Eliminar</button> <a asp-action="Index" class="btn btn-secondary">Cancelar</a></form>
