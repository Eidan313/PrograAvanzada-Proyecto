@model Pedidos360.Models.Producto
@{ViewData["Title"]="Detalle de producto";}
<h1>@Model.Nombre</h1><img src="@Url.Action("Imagen",new{id=Model.Id})" alt="Producto" style="max-width:220px"/>
<dl class="row mt-3"><dt class="col-sm-3">Código</dt><dd class="col-sm-9">@Model.Codigo</dd><dt class="col-sm-3">Precio</dt><dd class="col-sm-9">@Model.Precio</dd><dt class="col-sm-3">Stock</dt><dd class="col-sm-9">@Model.Stock</dd><dt class="col-sm-3">Impuesto</dt><dd class="col-sm-9">@Model.ImpuestoPorc %</dd></dl>
<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a> <a asp-action="Index" class="btn btn-secondary">Volver</a>
