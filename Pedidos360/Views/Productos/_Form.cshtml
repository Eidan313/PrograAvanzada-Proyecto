@model Pedidos360.ViewModels.ProductoFormViewModel
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<input asp-for="Id" type="hidden" />
<div class="row g-3">
 <div class="col-md-4"><label asp-for="Codigo" class="form-label">Código</label><input asp-for="Codigo" class="form-control"/><span asp-validation-for="Codigo" class="text-danger"></span></div>
 <div class="col-md-8"><label asp-for="Nombre" class="form-label">Nombre</label><input asp-for="Nombre" class="form-control"/><span asp-validation-for="Nombre" class="text-danger"></span></div>
 <div class="col-md-6"><label asp-for="CategoriaId" class="form-label">Categoría</label><select asp-for="CategoriaId" asp-items="Model.Categorias" class="form-select"><option value="0">Seleccione...</option></select><span asp-validation-for="CategoriaId" class="text-danger"></span></div>
 <div class="col-md-6"><label asp-for="Precio" class="form-label">Precio</label><input asp-for="Precio" type="number" step="0.01" min="0.01" class="form-control"/><span asp-validation-for="Precio" class="text-danger"></span></div>
 <div class="col-md-6"><label asp-for="Stock" class="form-label">Stock</label><input asp-for="Stock" type="number" min="0" class="form-control"/><span asp-validation-for="Stock" class="text-danger"></span></div>
 <div class="col-md-6"><label asp-for="ImpuestoPorc" class="form-label">Impuesto (%)</label><input asp-for="ImpuestoPorc" type="number" step="0.01" min="0" max="100" class="form-control"/><span asp-validation-for="ImpuestoPorc" class="text-danger"></span></div>
 <div class="col-12"><label asp-for="ImagenArchivo" class="form-label">Imagen JPG o PNG (máximo 2 MB)</label><input asp-for="ImagenArchivo" type="file" accept=".jpg,.jpeg,.png,image/jpeg,image/png" class="form-control"/><span asp-validation-for="ImagenArchivo" class="text-danger"></span></div>
 @if(!string.IsNullOrEmpty(Model.ImagenActual)){<div class="col-12"><img src="@Model.ImagenActual" alt="Imagen actual" style="max-height:110px"/><p class="text-muted">Si no subes otra imagen, se conserva esta.</p></div>}
 <div class="col-12"><div class="form-check"><input asp-for="Activo" class="form-check-input"/><label asp-for="Activo" class="form-check-label">Activo</label></div></div>
</div>
<div class="mt-4"><button type="submit" class="btn btn-primary">Guardar</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a></div>
